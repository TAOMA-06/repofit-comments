{
  "name": "repofit-comments",
  "version": "0.1.0",
  "private": true,
  "description": "Comment-first CLI for reducing AI-style narration in TypeScript diffs while preserving repository intent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TAOMA-06/repofit-comments.git"
  },
  "homepage": "https://github.com/TAOMA-06/repofit-comments#readme",
  "bugs": {
    "url": "https://github.com/TAOMA-06/repofit-comments/issues"
  },
  "type": "module",
  "bin": {
    "repofit": "dist/src/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
