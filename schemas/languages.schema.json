{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TAOMA-06/repofit-comments/schemas/languages.schema.json",
  "title": "RepoFit Comments language capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "toolVersion", "languages"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "type": { "const": "languages" },
    "toolVersion": { "type": "string" },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "batch", "extensions", "analysis", "automaticFixes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "batch": { "enum": [1, 2, 3] },
          "extensions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9_]+$" }
          },
          "analysis": { "const": "supported" },
          "automaticFixes": { "type": "boolean" }
        }
      }
    }
  }
}
